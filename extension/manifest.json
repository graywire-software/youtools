{
  "manifest_version": 3,
  "name": "YouTools",
  "version": "0.6.1",
  "description": "Player tools, optional content filters, sidebar customization, and app-window color and title controls for YouTube.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "YouTools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://youtube.com/embed/*"
      ],
      "js": [
        "settings.js",
        "filters.js",
        "sidebar.js",
        "player.js",
        "content.js",
        "pwa-shared.js",
        "pwa-theme.js",
        "pwa-title.js",
        "pwa-content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "ids": [
      "ahalfjmahmfelpoijaanbaldfmbleoik"
    ]
  }
}
